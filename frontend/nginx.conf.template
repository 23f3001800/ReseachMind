server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Azure's ingress terminates TLS ahead of us.
    absolute_redirect off;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # NOTE: nginx's add_header does not merge across levels — a location that
    # declares ANY add_header silently drops every inherited one. So the
    # security headers are repeated in each location that sets Cache-Control.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Hashed assets are immutable; index.html must never be cached or clients
    # keep booting an old bundle against a new API.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # ── API proxy ────────────────────────────────────────────
    # The API key is attached here, server side. The browser never receives it,
    # and because this is same-origin there is no CORS preflight at all.
    location /api/ {
        resolver 127.0.0.11 8.8.8.8 ipv6=off valid=30s;

        proxy_pass ${BACKEND_URL}/;

        # Azure Container Apps' ingress routes on SNI and closes the connection
        # during the handshake without it. nginx does NOT send SNI to an HTTPS
        # upstream unless this is on, which shows up only as a 502.
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        proxy_set_header X-API-Key        "${BACKEND_API_KEY}";
        proxy_set_header Host             ${BACKEND_HOST};
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: buffering would hold the whole pipeline response
        # until completion and defeat the point of streaming.
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        chunked_transfer_encoding on;

        # A full run can take ~3 minutes; keep this above the backend's own
        # REQUEST_TIMEOUT so nginx isn't the thing that gives up first.
        proxy_connect_timeout 75s;
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;

        client_max_body_size 12m;
    }

    # SPA fallback — client-side state is in React, so every path serves the shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
