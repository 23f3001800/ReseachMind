# ── Required ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here

# ── Search ────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_key_here      # optional; better search quality
SEARCH_PROVIDER=auto                      # auto | tavily | duckduckgo

# ── Model ─────────────────────────────────────────────────
LLM_MODEL=llama-3.3-70b-versatile
CONFIDENCE_THRESHOLD=0.7

# ── Pipeline tuning ───────────────────────────────────────
REQUEST_TIMEOUT=180                       # seconds; keep <= your host's request timeout
MAX_TOOL_ROUNDS=5
MAX_RESEARCH_RETRIES=1

# ── API protection ────────────────────────────────────────
# Leave API_KEY empty for local dev. SET IT before deploying anywhere public —
# without it, anyone with the URL can spend your Groq quota.
API_KEY=
ALLOWED_ORIGINS=*                         # comma-separated, e.g. https://your-app.streamlit.app
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=10

# ── Tracing (optional) ────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=researchmind
